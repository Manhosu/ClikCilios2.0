# Configurações do Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Configurações do Kiwify (Plataforma de Pagamentos)
KIWIFY_WEBHOOK_SECRET=your-kiwify-webhook-secret

# Configurações de Email (SendGrid) - BACKEND
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@ciliosclick.com
SENDGRID_FROM_NAME=CíliosClick

# Configurações de Email (SendGrid) - FRONTEND
VITE_SENDGRID_API_KEY=your-sendgrid-api-key
VITE_SENDGRID_FROM_EMAIL=noreply@ciliosclick.com
VITE_SENDGRID_FROM_NAME=CíliosClick

# URL da aplicação
NEXT_PUBLIC_APP_URL=https://ciliosclick.com
VITE_APP_URL=https://ciliosclick.com

# Configurações de Ambiente
NODE_ENV=production

# Instruções:
# 1. Copie este arquivo para .env.local para desenvolvimento
# 2. Para deploy no Vercel, configure essas variáveis no painel do Vercel
# 3. Substitua os valores 'your-*' pelos valores reais do seu projeto
# 4. Configure uma conta no SendGrid e obtenha a API key
# 5. Verifique o domínio de email no SendGrid antes de usar
# 6. Configure o webhook no Kiwify apontando para: https://seu-dominio.vercel.app/api/kiwify-webhook